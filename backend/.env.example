# Copy these names into your runtime environment or secret manager.
# Do not commit real values.
STORE_ID=0
SERVER_PORT=6789
REDIS_PORT=6379
# REDIS_ADDR=redis.example.internal:6379
BASIC_AUTH_USERNAME=local-user
BASIC_AUTH_PASSWORD=local-password
FROM_GATE_KEY=local-gate-key
FROM_DEVICE_KEY=local-device-key
CONTRACT_ID=local-contract-id
CLIENT_ID=local-client-id
CLIENT_SECRET=local-client-secret
GATE_TRANSACTION_INFO_BASE_URL=http://localhost:8080
GATE_TRANSACTION_INFO_PATH=/transaction-info
AZURE_DOCUMENT_INTELLIGENCE_URL=
AZURE_SUBSCRIPTION_KEY=local-azure-subscription-key

# Local Firestore Emulator (omit these in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:57242
FIRESTORE_ORDER_PROJECT_ID=demo-restaurant-order-server-order
FIRESTORE_CERTIFICATE_PROJECT_ID=demo-restaurant-order-server-certificate
